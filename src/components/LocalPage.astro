---
import Layout from "../layouts/SiteLayout.astro";
import MethodDiagram from "./MethodDiagram.astro";
import MethodCase from "./MethodCase.astro";
import { getPage } from "../lib/pages.mjs";
import { pathFor } from "../lib/paths.mjs";
import { topics } from "../lib/tree.mjs";
import { ui } from "../lib/ui.mjs";

const { lang, slug } = Astro.props;
const de = lang === "de";
const chapters = topics.filter(topic => topic.state === "draft" && topic.slug !== "lesestueck-wahrheit");
const content = getPage(lang, slug);
const marker = slug === "methode" ? "<!--worked-case-->" : "<!--chapter-shelf-->";
const [before, after] = content.split(marker);
if (["methode", "bibliothek"].includes(slug) && after === undefined) throw Error("Missing content marker on " + slug);
const followUp = {
  atlas: ["kollektive-intelligenz", "erkenntnisnavigator", "baum-des-wissens", "bibliothek", "schnittmengen"],
  bibliothek: ["baum-des-wissens", "forschungsstrom"],
  methode: ["erkenntnisnavigator", "werkstatt", "aussagen", "fragen-und-ki-prompt"],
  pruefstand: ["aussagen", "angriffsschwarm"],
  mitwirken: ["fragen-und-ki-prompt", "schnittmengen", "projektstatus"]
}[slug] ?? [];
---
<Layout lang={lang} slug={slug}>
  <Fragment set:html={before} />
  {slug === "methode" && <><MethodDiagram lang={lang} /><MethodCase lang={lang} /></>}
  {slug === "bibliothek" &&
    <section id="kapitel" class="container chapter-shelf" aria-labelledby="chapter-title">
      <p class="section-kicker">{de ? "IM LESESAL" : "READING ROOM"}</p>
      <h2 id="chapter-title">{de ? "Welcher Frage möchtest du nachgehen?" : "Which question would you like to explore?"}</h2>
      <p>{de ? "Diese Kapitel sind Arbeitsentwürfe. Jedes beginnt mit einer anderen Frage." : "These chapters are working drafts. Each starts with a different question."}</p>
      <ul>{chapters.map(topic =>
        <li id={"kapitel-" + topic.id}><a href={pathFor(lang, topic.slug, topic.anchor)}>{topic.name[lang]}</a><p>{topic.question[lang]}</p></li>
      )}</ul>
    </section>}
  {after && <Fragment set:html={after} />}
  {slug === "atlas" && <section class="container atlas-learning" id="lernendes-netz">
    <p class="section-kicker">{de ? "ATLAS ALS GRUNDLAGE" : "ATLAS AS A FOUNDATION"}</p>
    <h2>{de ? "Unsere Karte könnte Teil einer kollektiven Intelligenz werden." : "Our map could become part of a collective intelligence."}</h2>
    <p>{de ? "Die sechs Felder sind Themenräume, noch kein denkendes System. Erst wenn Menschen Verbindungen mit guten Gründen prüfen, Minderheiteneinwände erhalten und aus Fehlern lernen, könnte aus der Sammlung eine neue Erkenntnisfähigkeit entstehen." : "The six fields organize domains, not a thinking system. Only with justified links, preserved minority objections and learning from errors might the collection become a new capacity for inquiry."}</p>
    <a href={pathFor(lang,"kollektive-intelligenz")}>{de ? "Zur Grundidee und ihren Gegenproben" : "Explore the founding idea and its challenges"} →</a>
  </section>}
  {followUp.length > 0 &&
    <nav class="container next-links" aria-label={de ? "Weiterführende Seiten" : "Related pages"}>
      <strong>{de ? "Von hier aus weiter" : "Where to go next"}</strong>
      {followUp.map(route => <a href={pathFor(lang, route)}>{ui[lang].titles[route]} →</a>)}
    </nav>}
</Layout>

<style>
  .atlas-learning {border-top:1px solid var(--line);padding-block:3rem}
  .atlas-learning h2{font:clamp(1.8rem,3vw,2.8rem)/1.2 var(--serif);max-width:52rem}
  .atlas-learning p{max-width:54rem}
  .atlas-learning a{color:var(--gold-bright);text-underline-offset:.2em}
  .chapter-shelf { padding-block: clamp(3rem, 7vw, 6rem); }
  .chapter-shelf h2 { font-size: clamp(2.25rem, 5vw, 3.5rem); margin: 1rem 0; }
  .chapter-shelf ul { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.5rem 2.5rem; }
  .chapter-shelf li { border-top: 1px solid var(--line); padding-top: 1rem; scroll-margin-top: 7rem; }
  .chapter-shelf li p { margin: .5rem 0 0; }
  .chapter-shelf a { font: 1.4rem/1.4 var(--serif); }
  .next-links { display: flex; align-items: baseline; flex-wrap: wrap; gap: .8rem 1.6rem; padding-block: 2.2rem; border-top: 1px solid var(--line); }
  .next-links strong { font-size: .9rem; }
  .next-links a, .chapter-shelf a { color: var(--gold-bright); text-decoration: underline; text-underline-offset: .22em; }
</style>
