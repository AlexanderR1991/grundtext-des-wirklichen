 .forum-question-card__claim-label,.forum-question-card__relations>p{font-size:.79rem!important;font-weight:700;margin:0}
 .forum-question-card__claims{display:flex;flex-wrap:wrap;gap:.55rem 1rem}
 .forum-question-card__claims a{font-size:.79rem;min-height:34px;display:inline-flex;align-items:center}
 .forum-question-card__relations{border-top:1px solid var(--line);padding-top:.7rem}
 .forum-question-card__relations ul{padding-left:1.1rem;margin:.65rem 0 0}
 .forum-question-card__relations li{padding:.35rem 0;font-size:.8rem;line-height:1.55}
 .forum-question-card__relations li span{display:block;color:#b7bcb7}
 .forum-question-card__source{font-size:.75rem;margin-top:auto}
 .forum-questions__bottom{max-width:62rem;margin-top:1.4rem;font-size:.86rem;line-height:1.75}
 @media(max-width:900px){.forum-workspaces{grid-template-columns:1fr}}
 @media(max-width:700px){.forum-question-grid{grid-template-columns:1fr}}
 .forum-esoteric-details{border:1px solid var(--line);padding:1rem 1.4rem;margin:1.5rem 0}.forum-esoteric-details summary{cursor:pointer;color:var(--gold-bright);font-size:1rem}.forum-esoteric-details ul{list-style:none;padding:0;margin:1rem 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem 1.1rem}.forum-esoteric-details li a{display:inline-block;padding:.35rem 0;color:var(--gold-bright);text-decoration:underline;text-underline-offset:.2em;font-size:.84rem;line-height:1.5}@media(max-width:900px){.forum-esoteric-details ul{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.forum-esoteric-details ul{grid-template-columns:1fr}}
</style>
<script>
 const atlas=document.querySelector("[data-question-atlas]");
 const search=atlas?.querySelector("[data-forum-question-search]");
 if(search){
  const cards=[...atlas.querySelectorAll("[data-forum-question-card]")];
  const count=atlas.querySelector("[data-forum-question-count]");
  const empty=atlas.querySelector("[data-forum-question-empty]");
  search.disabled=false;
  search.addEventListener("input",()=>{
   const query=search.value.normalize("NFKC").toLocaleLowerCase().trim();
   let visible=0;
   for(const card of cards){
    const show=!query||card.dataset.searchText.includes(query);
    card.hidden=!show;
    if(show)visible++;
   }
   count.textContent=visible+" "+atlas.dataset.resultsLabel;
   empty.hidden=visible!==0;
  });
 }
</script>
