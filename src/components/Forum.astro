 @media(max-width:680px){.forum-hero h1{font-size:clamp(2.65rem,9.5vw,4.5rem)}.forum-claim-grid,.forum-steps{grid-template-columns:1fr}.forum-rooms article{padding:1.5rem}.forum-claim h3{margin-bottom:1.3rem}}

 .forum-question-atlas{scroll-margin-top:8rem}
 .forum-workspaces{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-bottom:2.5rem}
 .forum-workspaces>div{border:1px solid var(--line);background:#121a1b;padding:1.3rem;min-width:0}
 .forum-workspaces span{display:block;color:var(--gold-bright);font-size:.68rem;letter-spacing:.12em;margin-bottom:.8rem}
 .forum-workspaces strong{display:block;font:1.45rem/1.3 var(--serif);font-weight:500}
 .forum-workspaces p{font-size:.87rem;line-height:1.7;margin-bottom:0}
 .forum-question-search{display:grid;gap:.5rem;max-width:46rem;margin-bottom:1.8rem}
 .forum-question-search label{font-weight:650;font-size:.94rem}
 .forum-question-search input{width:100%;min-height:46px;background:#0b1011;color:#f4f0e9;border:1px solid #b99d69;padding:.8rem 1rem;font:inherit;border-radius:3px}
 .forum-question-search p{margin:.25rem 0;font-size:.81rem;line-height:1.6}
 .forum-question-search__note a,.forum-question-card a,.forum-questions__bottom a{color:var(--gold-bright);text-underline-offset:.2em}
 .forum-question-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
 .forum-question-card{display:flex;flex-direction:column;gap:.85rem;border:1px solid var(--line);padding:1.5rem;background:#101719;min-width:0;scroll-margin-top:8rem}
 .forum-question-card[hidden],.forum-question-atlas [hidden]{display:none!important}
 .forum-question-card__meta{font-size:.7rem!important;letter-spacing:.06em;color:var(--gold-bright);margin:0}
