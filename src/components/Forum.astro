---
import Layout from "../layouts/SiteLayout.astro";
import EverydayQuestions from "./EverydayQuestions.astro";
import {pathFor} from "../lib/paths.mjs";
import project from "../../public/project.json" with {type: "json"};
import register from "../../public/knowledge/claims.json";
import forum from "../../public/knowledge/forum-threads.json";
import questionAtlas from "../../public/knowledge/questions.json";
import {connectionsForQuestion} from "../lib/questions.mjs";
import "../styles/mission.css";
import esoterik from "../../public/knowledge/esoterik-tree.json";

const {lang="de"}=Astro.props;
const en=lang==="en";
const t=(de,english)=>en?english:de;
const threads=new Map(forum.threads.map(thread=>[thread.claim_id,thread.issue_number]));
const discussions=project.repository+"/discussions";
const claimById=new Map(register.claims.map(claim=>[claim.id,claim]));
const relationLabels={
 depends_on:{outgoing:t("Hängt ab von","Depends on"),incoming:t("Voraussetzung für","Needed by")},
 subquestion_of:{outgoing:t("Teilfrage von","Subquestion of"),incoming:t("Enthält Teilfrage","Has subquestion")},
 related_to:{outgoing:t("Verbunden mit","Related to"),incoming:t("Verbunden mit","Related to")},
 alternative_framing:{outgoing:t("Andere Formulierung","Alternative framing"),incoming:t("Andere Formulierung","Alternative framing")},
 possible_duplicate:{outgoing:t("Mögliche Dopplung","Possible duplicate"),incoming:t("Mögliche Dopplung","Possible duplicate")}
};
const reviewText={
 unreviewed:t("Ungeprüft","Unreviewed"),
 in_review:t("In Prüfung","Under review"),
 reviewed:t("Prüfung dokumentiert","Review documented"),
 disputed:t("Umstritten","Disputed"),
 withdrawn:t("Zurückgezogen","Withdrawn")
};
---
<Layout lang={lang} slug="forum" description={t("Alltagsfragen über Liebe, Arbeit, Essen und mehr. Lies eine erste philosophische Antwort und prüfe sie an einem Beispiel aus dem Leben.","Everyday questions about love, work, food and more. Read a first philosophical answer and test it against a real-life example.")}>
 <section class="forum-hero" aria-labelledby="forum-title">
  <div class="container forum-hero__grid">
   <div>
    <p class="section-kicker">{t("DAS FORUM · EIN ORT FÜR VIELE STIMMEN","THE FORUM · A PLACE FOR MANY VOICES")}</p>
    <h1 id="forum-title">{t("Das Forum.","The Forum.")}<br /><em>{t("Widerspruch ist willkommen.","Disagreement is welcome.")}</em></h1>
    <p class="forum-lead">{t("Hier gehen wir Fragen nach, die uns im Alltag beschäftigen. Such dir eine aus und prüfe unsere Antwort an einem Fall, den du kennst.","Here we explore questions we live with every day. Pick one and test our answer against a case you know.")}</p>
    <p>{t("Wir diskutieren nicht, um recht zu behalten. Ein guter Einwand kann das System verändern.","We discuss not to win, but because a strong objection can change the system.")} <a class="subtle-link" href={pathFor(lang,"regelkreis")}>{t("Unsere Regel META-01","Our rule META-01")} →</a></p>
    <div class="button-row">
     <a class="button button--gold" href="#alltagsfragen">{t("Eine Alltagsfrage wählen ↓","Pick an everyday question ↓")}</a>
     <a class="button button--ghost" href={discussions} target="_blank" rel="noopener noreferrer">{t("Offene Gespräche ↗","Open conversations ↗")}</a>
    </div>
   </div>
   <aside class="forum-hero__seal" aria-label={t("Drei Fragen für ein gutes Gespräch","Three questions for a constructive discussion")}>
    <span class="forum-hero__glyph" aria-hidden="true">Φ</span>
    <p class="section-kicker">{t("DREI FRAGEN","THREE QUESTIONS")}</p>
    <ol>
     <li>{t("Was meinst du genau?","What exactly do you mean?")}</li>
     <li>{t("Was spricht dagegen?","What challenges it?")}</li>
     <li>{t("Was könnte uns umstimmen?","What could change our minds?")}</li>
    </ol>
   </aside>
  </div>
 </section>

 <section class="forum-section container" id="rede-01" aria-labelledby="forum-rede-01-title">
  <p class="section-kicker">{t("REDE-01 · FREIE REDE UND SCHUTZ","REDE-01 · FREE EXPRESSION AND SAFETY")}</p>
  <h2 id="forum-rede-01-title">{t("Auch das Unbequeme darf gesagt werden.","Even uncomfortable things can be said.")}</h2>
  <p>{t("Eine Meinung wird nicht entfernt, nur weil sie uns verletzt, gegen die Mehrheit steht oder unser Projekt kritisiert. Aber glaubhafte Drohungen, gezielte Belästigung und private Daten dürfen Menschen nicht schutzlos ausliefern. Wir unterscheiden vier mögliche Entscheidungen: stehen lassen, mit Kontext versehen, vorläufig einschränken und prüfen, oder die öffentliche Verbreitung beenden.","A viewpoint is not removed merely because it hurts, opposes the majority or criticizes our project. But credible threats, targeted harassment and exposure of private data must not leave people unprotected. We distinguish four possible decisions: retain, add context, provisionally restrict and review, or stop public distribution.")}</p>
  <p>{t("Die Regeln selbst sind anfechtbar. Eine Maßnahme braucht konkrete Gründe, eine verantwortliche menschliche Prüfung und einen Weg zum Einspruch. Das ist ein Entwurf, keine heute schon betriebene Moderationssoftware.","The rules themselves can be challenged. A restriction needs specific reasons, accountable human review and a route to appeal. This is a proposal, not moderation software operating today.")} <a href={project.repository+"/blob/main/docs/redefreiheit-und-schutz.md"} target="_blank" rel="noopener noreferrer">{t("Regelentwurf REDE-01 lesen ↗","Read the REDE-01 proposal ↗")}</a></p>
 </section>

 <EverydayQuestions lang={lang} />
 <section class="forum-section container" aria-labelledby="forum-universal-title">
   <p class="section-kicker">{t("GRUNDFRAGEN · NEUE VERBINDUNGEN","FUNDAMENTAL QUESTIONS · CROSS-DOMAIN CONNECTIONS")}</p>
   <h2 id="forum-universal-title">{t("Welche Frage taucht überall wieder auf?","Which question keeps recurring?")}</h2>
   <p>{t("Der neue Grundfragenatlas sammelt übergreifende Fragen mit Quellen und Gegenfragen. Das ist eine redaktionell ungeprüfte Forschungsagenda, keine automatisch ausgewertete Menschenmeinung.","The new fundamental-question atlas collects cross-domain questions with source links and counterquestions. It is an unreviewed editorial research agenda, not an automated evaluation of people's views.")}</p>
   <div class="button-row"><a class="button button--gold" href={pathFor(lang,"grundfragen")}>{t("Grundfragen untersuchen","Explore fundamental questions")} →</a>
     <a class="button button--ghost" href={project.repository+"/issues/new?template=grundfrage.yml"} target="_blank" rel="noopener noreferrer">{t("Frage oder Einwand einreichen","Submit a question or objection")} ↗</a></div>
 </section>



 <section class="forum-section container" id="esoterik-forum" aria-labelledby="esoterik-forum-title">
  <p class="section-kicker">{t("OFFENER WISSENSBAUM · NEUE ÄSTE","OPEN KNOWLEDGE TREE · NEW BRANCHES")}</p>
  <h2 id="esoterik-forum-title">{t("Esoterik ist kein einzelner Gedanke.","Esotericism is not a single idea.")}</h2>
  <p>{t("Die neue Esoterik-Karte enthält","The new esotericism map contains")} {esoterik.branches.length} {t("Hauptäste und","main branches and")} {esoterik.branches.reduce((sum,branch)=>sum+branch.children.length,0)} {t("diskutierbare Unteräste. Jeder Ast trägt eine andere Frage; kein Beitrag wird per Mehrheit oder durch KI automatisch wahr.","discussable subbranches. Each carries its own question; neither votes nor AI automatically establish its truth.")}</p>
  <details class="forum-esoteric-details"><summary>{t("Die Hauptäste anzeigen","Show the main branches")}</summary>
   <ul>{esoterik.branches.map(branch=><li><a href={pathFor(lang,"esoterik-katalog","ast-"+branch.id.toLowerCase())}>{branch.id} · {branch.title[lang]}</a></li>)}</ul>
  </details>
  <div class="button-row"><a class="button button--gold" href={pathFor(lang,"esoterik-katalog")}>{t("Fragenbaum erkunden","Explore the question tree")} ↗</a><a class="button button--ghost" href={project.repository+"/issues/new?template=esoterik-ast.yml"} target="_blank" rel="noopener noreferrer">{t("Neuen Unterast vorschlagen","Propose a new subbranch")} ↗</a></div>
  <p class="forum-questions__bottom">{t("Diskussionsvorschläge werden als öffentliche GitHub Issues eingereicht. Sie sind keine automatisch erzeugten Debatten und erscheinen erst nach redaktioneller Prüfung im Katalog. Lesen ist ohne Konto möglich.","Discussion proposals are submitted as public GitHub Issues. They are not auto-created threads and enter the catalogue only after editorial review. Reading requires no account.")}</p>
 </section>


 <section class="forum-section container" aria-labelledby="forum-places">
  <div class="forum-section__intro">
   <p class="section-kicker">{t("DREI WEGE, EIN GEMEINSAMES DENKEN","THREE PATHS, ONE SHARED INQUIRY")}</p>
   <h2 id="forum-places">{t("Wo möchtest du beginnen?","Where would you like to begin?")}</h2>
   <p>{t("Die griechische Agora und das römische Forum haben uns inspiriert. Heute findest du hier drei Wege in unsere öffentlichen Gespräche und Prüfungen auf GitHub.","The Greek agora and Roman forum inspired us. Here you’ll find three ways into our public conversations and reviews on GitHub.")}</p>
  </div>
  <div class="forum-rooms">
   <article>
    <span class="forum-room__number">01 · AGORA</span>
    <h3>{t("Der offene Platz","The open square")}</h3>
    <p>{t("Eine Frage stellen, eine Idee erkunden, Perspektiven teilen. Ohne dass schon eine fertige These nötig ist.","Ask a question, explore an idea, share perspectives. No finished thesis required.")}</p>
    <a href={discussions} target="_blank" rel="noopener noreferrer">{t("Gespräche ansehen ↗","Explore conversations ↗")}</a>
   </article>
   <article>
    <span class="forum-room__number">02 · STOA</span>
    <h3>{t("Der Ort der Prüfung","The place of examination")}</h3>
    <p>{t("Bei einer konkreten Aussage bleiben, ihren Geltungsbereich klären, Quellen und Gegenbeispiele zusammentragen.","Stay with a specific claim, clarify its scope, and examine sources and counterexamples.")}</p>
    <a href="#aussagen">{t("Aussagen und Debatten ↓","Claims and discussions ↓")}</a>
   </article>
   <article>
    <span class="forum-room__number">03 · CURIA</span>
    <h3>{t("Der Weg zur Entscheidung","The path to a decision")}</h3>
    <p>{t("Was soll am Werk geändert werden? Änderungen werden öffentlich begründet, geprüft und versioniert – nicht per Mehrheitsentscheid als wahr erklärt.","What should change in the work? Edits are publicly reasoned, reviewed and versioned, never declared true by a majority vote.")}</p>
    <a href={project.repository+"/pulls"} target="_blank" rel="noopener noreferrer">{t("Änderungen verfolgen ↗","Follow proposed changes ↗")}</a>
   </article>
  </div>
 </section>


 <section class="forum-section container forum-question-atlas" id="fragenatlas" data-question-atlas data-results-label={t("Fragen sichtbar","questions shown")} aria-labelledby="forum-questions-title">
  <div class="forum-section__intro">
   <p class="section-kicker">{t("MENSCHEN · KI-LABOR · FRAGENATLAS","PEOPLE · AI LAB · QUESTION ATLAS")}</p>
   <h2 id="forum-questions-title">{t("Viele Fragen. Ein nachvollziehbares Netz.","Many questions. One traceable network.")}</h2>
   <p>{t("Das Gespräch bleibt menschlich. Die bestehenden KI-Schwärme arbeiten in begrenzten Forschungsströmen – nicht als endlose Kommentatoren. Ein redaktionelles Fragenregister verbindet Fragen mit Aussagen und untereinander, ohne sie automatisch zusammenzulegen.","Conversation stays human. Existing AI swarms work within limited research streams, not as endless commenters. An editorial question register connects questions to claims and to each other without automatically merging them.")}</p>
  </div>
  <div class="forum-workspaces" aria-label={t("Drei getrennte Arbeitsräume","Three distinct workspaces")}>
   <div><span>01 · {t("FORUM","FORUM")}</span><strong>{t("Menschen sprechen","People deliberate")}</strong><p>{t("Freie Gespräche, begründete Einwände und auf Wunsch angefragte KI-Hilfe. Keine ungefragten Agenten-Debatten.","Open conversation, reasoned objections and AI help only when requested. No unsolicited agent debates.")}</p></div>
   <div><span>02 · {t("LABOR","LAB")}</span><strong>{t("KI untersucht","AI investigates")}</strong><p>{t("Begrenzte, als ungeprüft markierte Entwürfe. Kein automatischer Versand an Discussions oder Issues.","Bounded, explicitly unverified drafts. No automatic posting to Discussions or Issues.")}</p></div>
   <div><span>03 · {t("FRAGENATLAS","QUESTION ATLAS")}</span><strong>{t("Verbindungen prüfen","Examine connections")}</strong><p>{t("Stabile IDs, begründete Querverbindungen und Links zum Aussagenregister. Ein kleiner Pilot, kein vollständiger Live-Index.","Stable IDs, reasoned cross-links and links to the claim register. A small pilot, not a complete live index.")}</p></div>
  </div>
  <div class="forum-question-search">
   <label for="forum-question-query">{t("Fragen und Themen im Beispielregister durchsuchen","Search questions and topics in the example register")}</label>
   <input id="forum-question-query" type="search" placeholder={t("z. B. KI, Verantwortung, Belege","e.g. AI, responsibility, evidence")} autocomplete="off" maxlength="160" data-forum-question-search disabled />
   <p class="forum-question-search__note">{t("Die Suche vergleicht nur Wörter im Browser; sie ist keine KI-Auswertung. Alle Beispiel-Fragen sind ungeprüft.","Search compares words in your browser only; it is not AI analysis. All example questions remain unreviewed.")} <a href={pathFor(lang,"erkenntnisnavigator")}>{t("Erkenntnisnavigator öffnen ↗","Open knowledge navigator ↗")}</a></p>
   <p aria-live="polite" data-forum-question-count>{questionAtlas.questions.length} {t("Fragen sichtbar","questions shown")}</p>
  </div>
  <div class="forum-question-grid" id="forum-question-grid">
   {questionAtlas.questions.map(q=><article class="forum-question-card" id={"frage-"+q.id} data-forum-question-card data-search-text={[q.id,q.question.de,q.question.en,...q.topics,...q.claim_ids].join(" ").toLocaleLowerCase()}>
    <p class="forum-question-card__meta">{q.id} · {t("Redaktionelle Beispielfrage · ungeprüft","Editorial example question · unreviewed")}</p>
    <h3>{q.question[lang]}</h3>
    <p class="forum-question-card__claim-label">{t("Verknüpfte Aussagen","Linked claims")}</p>
    <div class="forum-question-card__claims">{q.claim_ids.map(id=><a href={pathFor(lang,"aussagen",id)}>{id} · {t("Aussage prüfen","Examine claim")}</a>)}</div>
    {connectionsForQuestion(questionAtlas,q.id).length>0&&<div class="forum-question-card__relations">
     <p>{t("Begründete Verbindungen","Reasoned connections")}</p>
     <ul>{connectionsForQuestion(questionAtlas,q.id).map(link=><li><a href={"#frage-"+link.question.id}>{relationLabels[link.type][link.direction]} · {link.question.id}</a><span>{link.reason[lang]}</span></li>)}</ul>
    </div>}
    <a class="forum-question-card__source" href={q.source_url} target="_blank" rel="noopener noreferrer">{t("Herkunft der Beispielfrage ↗","Example question provenance ↗")}</a>
   </article>)}
  </div>
  <p data-forum-question-empty hidden>{t("Kein Treffer in diesem kleinen Register. Das bedeutet nicht, dass die Frage unbeantwortet oder unwichtig ist.","No match in this small register. That does not mean the question is unanswerable or unimportant.")}</p>
  <p class="forum-questions__bottom">{t("Eine eigene Frage fehlt? Sie darf neu sein, einem bestehenden Thema widersprechen oder einen übersehenen Unterschied zeigen. Ein Vorschlag führt nie automatisch zu Konsens oder einer höheren Erkenntnisreife.","Have a missing question? It may be new, challenge an existing topic or reveal an overlooked distinction. A proposal never automatically establishes consensus or higher evidence maturity.")} <a href={project.repository+"/issues/new?template=frage.yml"} target="_blank" rel="noopener noreferrer">{t("Frage einreichen ↗","Submit a question ↗")}</a> · <a href={project.repository+"/blob/main/docs/fragenatlas.md"} target="_blank" rel="noopener noreferrer">{t("Regeln für Zusammenführung und KI ↗","Read the AI and question-linking rules ↗")}</a></p>
 </section>

 <section class="forum-section forum-claims" id="aussagen" aria-labelledby="forum-claims-title">
  <div class="container">
   <div class="forum-section__intro">
    <p class="section-kicker">{t("DIREKT MIT DEM AUSSAGENREGISTER VERBUNDEN","DIRECTLY LINKED TO THE CLAIM REGISTER")}</p>
    <h2 id="forum-claims-title">{t("Jede Aussage hat ihren eigenen Gesprächsfaden.","Every claim has its own discussion thread.")}</h2>
    <p>{t("Die Kennung bleibt stabil, auch wenn die Aussage überarbeitet wird. Im Forum wird diskutiert; im Register stehen die redaktionell dokumentierte Fassung, Prüfstatus und Versionsgeschichte.","The identifier stays stable even when the statement is revised. The forum holds discussion; the register holds the editorially documented statement, review status and version history.")}</p>
   </div>
   <div class="forum-claim-grid">
    {register.claims.map(claim=><article class="forum-claim">
     <div class="forum-claim__meta"><span>{claim.id} · v{claim.version}</span><span>R{claim.maturity.level} · {reviewText[claim.review_status]}</span></div>
     <h3>{claim.statement[lang]}</h3>
     <div class="forum-claim__links">
      <a class="forum-claim__thread" href={project.repository+"/issues/"+threads.get(claim.id)} target="_blank" rel="noopener noreferrer">{t("Debatte lesen & antworten ↗","Read & join the debate ↗")}</a>
      <a href={pathFor(lang,"aussagen",claim.id)}>{t("Aussage prüfen →","Examine the claim →")}</a>
     </div>
    </article>)}
   </div>
   <p class="forum-claims__note">{t("Diese Fäden sind öffentliche GitHub Issues. Sie dokumentieren Gespräche, keine bestätigten Wahrheitsurteile. Einen gezielten Einwand kannst du zusätzlich über das Prüf-Formular einreichen.","These threads are public GitHub Issues. They document conversations, not verified truth judgments. You can also submit a focused objection through the challenge form.")} <a href={project.repository+"/issues/new?template=angriff.yml"} target="_blank" rel="noopener noreferrer">{t("Einwand einreichen ↗","Submit an objection ↗")}</a></p>
  </div>
 </section>

 <section class="forum-section container forum-method" aria-labelledby="forum-method-title">
  <div class="forum-section__intro">
   <p class="section-kicker">{t("VOM GESPRÄCH ZUR ERKENNTNIS","FROM CONVERSATION TO UNDERSTANDING")}</p>
   <h2 id="forum-method-title">{t("Was geschieht mit einem guten Einwand?","What happens to a good objection?")}</h2>
  </div>
  <ol class="forum-steps">
   <li><strong>01</strong><div><h3>{t("Verstehen","Understand")}</h3><p>{t("Begriffe, Voraussetzungen und den stärksten fairen Sinn der Aussage klären.","Clarify terms, assumptions and the strongest fair reading of the claim.")}</p></div></li>
   <li><strong>02</strong><div><h3>{t("Prüfen","Examine")}</h3><p>{t("Einwände, Beispiele, Daten oder Quellen nach den passenden Maßstäben prüfen.","Test objections, examples, data or sources with methods appropriate to the claim.")}</p></div></li>
   <li><strong>03</strong><div><h3>{t("Unterschiede festhalten","Record disagreement")}</h3><p>{t("Konsens nur dokumentieren, wenn er wirklich besteht. Offen gebliebener Dissens ist ein ehrliches Ergebnis.","Document agreement only when it actually exists. Unresolved disagreement is an honest outcome.")}</p></div></li>
   <li><strong>04</strong><div><h3>{t("Korrigieren","Revise")}</h3><p>{t("Erst begründeter Änderungsvorschlag, redaktionelle Prüfung und Versionierung ändern den Registereintrag. Kein Klick erhöht die Erkenntnisreife.","Only a reasoned proposal, editorial review and versioning change the register. No click raises evidence maturity.")}</p></div></li>
  </ol>
 </section>

 <section class="forum-section forum-invitation" aria-labelledby="forum-invite-title">
  <div class="container forum-invitation__inner">
   <div>
    <p class="section-kicker">{t("DEIN ERSTER BEITRAG","YOUR FIRST CONTRIBUTION")}</p>
    <h2 id="forum-invite-title">{t("Du musst nicht recht haben, um etwas beizutragen.","You do not have to be right to contribute.")}</h2>
    <p>{t("Auch eine einfache Frage kann eine wichtige Voraussetzung sichtbar machen. Beginne gern mit der Begrüßungsdiskussion oder erkunde die offenen Gespräche.","Even a simple question can reveal an important assumption. Start with the welcome discussion or explore the open conversations.")}</p>
    <div class="button-row"><a class="button button--gold" href={discussions+"/7"} target="_blank" rel="noopener noreferrer">{t("Zur Begrüßung ↗","Go to the welcome thread ↗")}</a><a class="button button--ghost" href={discussions} target="_blank" rel="noopener noreferrer">{t("Alle Diskussionen ↗","All discussions ↗")}</a></div>
   </div>
   <aside class="forum-boundaries">
    <h3>{t("Frei denken. Menschen achten.","Think freely. Respect people.")}</h3>
    <p>{t("Widerspruch darf scharf sein; persönliche Angriffe, Drohungen und private Daten haben hier keinen Platz. Du darfst auch beim Dissens bleiben oder das Gespräch verlassen.","Criticism may be sharp; personal attacks, threats and private information do not belong here. It is also fine to disagree or leave the discussion.")}</p>
    <p>{t("Lesen ist öffentlich möglich; zum Schreiben brauchst du derzeit ein GitHub-Konto. Beiträge sind öffentlich. Es gibt noch keinen zugesagten vertraulichen Meldeweg, keine garantierten Antwortzeiten und keine unabhängige Moderationsinstanz.","Reading is public; posting currently requires a GitHub account. Contributions are public. There is no promised confidential reporting channel, guaranteed response time or independent moderation body yet.")}</p>
    <a href={project.repository+"/blob/main/CODE_OF_CONDUCT.md"} target="_blank" rel="noopener noreferrer">{t("Diskussionskodex lesen ↗","Read the code of conduct ↗")}</a>
    <a href={project.repository+"/blob/main/docs/forum.md"} target="_blank" rel="noopener noreferrer">{t("So funktioniert das Forum ↗","How the forum works ↗")}</a>
   </aside>
  </div>
 </section>
</Layout>

<style>
 .forum-hero{padding:clamp(2.25rem,5vw,4.5rem) 0;background:radial-gradient(ellipse at 79% 44%,#6d503229,transparent 56%),linear-gradient(120deg,#0b0e10,#111b1c);border-bottom:1px solid var(--line);overflow:hidden}
 .forum-hero__grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(15rem,.62fr);align-items:center;gap:clamp(2rem,5vw,5rem)}
 .forum-hero h1{font-size:clamp(3rem,6vw,5.7rem);letter-spacing:-.055em;line-height:1.06;margin:.24em 0 .28em}
 .forum-hero h1 em{font-weight:400;color:var(--gold-bright)}
 .forum-lead{max-width:46rem;color:#e4d9c5;font:clamp(1.2rem,2vw,1.6rem)/1.6 var(--serif)}
 .forum-hero__grid>div>p:not(.section-kicker){max-width:45rem}
 .forum-hero .button-row{margin-top:2rem}
 .forum-hero__seal{padding:1.5rem 2rem;border:1px solid #bda1754a;background:radial-gradient(circle at 50% 22%,#ae8d5420,transparent 65%),#121719;text-align:center}
 .forum-hero__glyph{display:block;font:3.4rem/1.1 var(--serif);color:var(--gold-bright);margin-bottom:.7rem}
 .forum-hero__seal ol{margin:1.3rem 0 0;padding:1rem 0 0;border-top:1px solid var(--line);list-style:none;text-align:left;counter-reset:forum}
 .forum-hero__seal li{counter-increment:forum;padding:.7rem 0;border-bottom:1px solid var(--line);font:1rem/1.45 var(--serif)}
 .forum-hero__seal li::before{content:counter(forum,decimal-leading-zero);font:600 .65rem var(--sans);letter-spacing:.12em;color:var(--gold);margin-right:.75rem}
 .forum-section{padding-block:clamp(3.2rem,6vw,5.6rem)}
 .forum-section__intro{max-width:52rem;margin-bottom:2.4rem}
 .forum-section h2{font-size:clamp(2.2rem,4.6vw,4rem);letter-spacing:-.04em;line-height:1.13;margin:.35em 0}
 .forum-rooms{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.1rem}
 .forum-rooms article{border-top:2px solid var(--gold);padding:2rem;background:#141b1b;display:flex;flex-direction:column}
 .forum-room__number{font-size:.69rem;color:var(--gold-bright);letter-spacing:.18em}
 .forum-rooms h3{font:clamp(1.6rem,2.6vw,2.4rem)/1.2 var(--serif);margin:1.3rem 0 .9rem}
 .forum-rooms p{font-size:.92rem;line-height:1.75;flex:1}
