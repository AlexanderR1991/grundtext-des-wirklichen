---
import {ui,navigation} from "../lib/ui.mjs";
import UniversalQuestionsContext from "../components/UniversalQuestionsContext.astro";
import {pathFor,absoluteFor,base} from "../lib/paths.mjs";
import project from "../../public/project.json" with {type: "json"};
const {lang="de",slug="index",root=false}=Astro.props;
const t=ui[lang];
const footerGroups = [
  { title: t.explore, routes: ["erkenntnisnavigator", "baum-des-wissens", "esoterik-katalog", "bibliothek", "aussagen", "forum", "pruefstand", "die-bruecke", "philosophischer-motor", "grundfragen", "forschungsstrom"] },
  { title: t.project, routes: ["mission", "regelkreis", "methode", "ki-und-mensch", "projektstatus", "projektobservatorium", "mitwirken"] }
];
const description = Astro.props.description ?? t.description;
const title = Astro.props.pageTitle ?? (root ? "Choose your language / Sprache wählen" : t.titles[slug]);
const siteRoot="https://alexanderr1991.github.io"+base;
const canonical=root?siteRoot:absoluteFor(lang,slug);
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b0d0f" />
<meta name="color-scheme" content="dark" />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title+" · "+t.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="application-name" content={t.name} />
<meta property="og:locale" content={lang==="de"?"de_DE":"en_GB"} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="de" href={absoluteFor("de",slug)} />
<link rel="alternate" hreflang="en" href={absoluteFor("en",slug)} />
<link rel="alternate" hreflang="x-default" href={siteRoot} />
<link rel="icon" type="image/svg+xml" href={base+"assets/signet.svg"} />
<link rel="stylesheet" href={base+"assets/style.css"} />
<title>{title} · {t.name}</title>
<script is:inline src={base+"assets/site.js"} defer></script>
</head>
<body>
<a class="skip-link" href="#inhalt">{lang==="de"?"Zum Inhalt springen":"Skip to content"}</a>
<header class="site-header"><div class="site-header__inner">
<a class="brand" href={pathFor(lang)} aria-label={t.name+(lang==="de"?" – Startseite":" – homepage")}>
<img src={base+"assets/signet.svg"} alt="" width="38" height="38" /><span class="brand__name">{t.name}<small>{t.subtitle}</small></span>
</a>
<button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation"><span>{t.menu}</span><span class="menu-lines" aria-hidden="true">☰</span></button>
<nav id="site-navigation" class="site-nav" aria-label={lang==="de"?"Hauptnavigation":"Main navigation"}>
{navigation.map(([slugName,i])=><a href={pathFor(lang,slugName)} aria-current={!root&&slug===slugName?"page":undefined}>{t.nav[i]}</a>)}
</nav>
<nav class="language-switch" aria-label={lang==="de"?"Sprache":"Language"}>
<a href={pathFor("de",slug)} lang="de" hreflang="de" aria-current={!root&&lang==="de"?"page":undefined}>DE</a><span aria-hidden="true">/</span>
<a href={pathFor("en",slug)} lang="en" hreflang="en" aria-current={!root&&lang==="en"?"page":undefined}>EN</a>
</nav>
<a class="header-project" href={project.repository} target="_blank" rel="noopener noreferrer">GITHUB <span aria-hidden="true">↗</span></a>
</div></header>
<div class="edition-line"><a href={pathFor(lang,"projektstatus")} data-project-version={project.version}>{t.name} / VERSION {project.version} ↗</a><span>{t.motto}</span></div>
{lang==="en"&&!root&&<div class="translation-notice"><div class="container"><span aria-hidden="true">◇</span><span>{t.status}</span><a href={pathFor(lang,"projektstatus","sprachfassungen")}>Translation review ↗</a><a href={pathFor("de",slug)}>Deutsch →</a></div></div>}
<main id="inhalt"><slot /><UniversalQuestionsContext lang={lang} slug={slug}/></main>
<footer class="footer"><div class="container footer__grid">
<div><img src={base+"assets/signet.svg"} width="54" height="54" alt="" /><h2>{t.footerTitle}</h2><p>{t.footerDescription}</p></div>
<div class="footer__links">
  {footerGroups.map(group => <div><strong>{group.title}</strong>
    {group.routes.map(route => <a href={pathFor(lang,route)}>{t.titles[route]}</a>)}
    {group.title === t.project && <a href={project.repository}>{t.source} ↗</a>}
  </div>)}
</div>
</div><div class="container footer__bottom"><span>{t.copyright}</span><span>{t.disclosure}</span><a class="footer__donate" href={pathFor(lang,"mitwirken","unterstuetzen")}>{lang==="de"?"Spenden":"Donate"} <span aria-hidden="true">🤍</span></a><a href={pathFor(lang,"impressum")}>{lang==="de"?"Impressum":"Legal notice"}</a><a href={pathFor(lang,"datenschutz")}>{lang==="de"?"Datenschutz":"Privacy"}</a><a href={project.repository+"/blob/main/LICENSING.md"} target="_blank" rel="noopener noreferrer">{lang==="de"?"Lizenzdetails & Ausnahmen ↗":"License details & exceptions ↗"}</a></div></footer>
</body></html>

<style is:global>
:focus-visible{outline:2px solid var(--gold-bright);outline-offset:3px}
.footer__bottom{color:#a1a49a}
.footer__donate{display:inline-flex;align-items:center;justify-content:center;gap:.45em;min-height:38px;padding:8px 13px;border:1px solid rgba(255,255,255,.24);border-radius:999px;color:#f2f2ef;font-size:11px;line-height:1.2;letter-spacing:.04em;text-decoration:none;white-space:nowrap;transition:border-color .2s ease,background-color .2s ease}
.footer__donate span{font-size:14px;line-height:1}
.footer__donate:hover{border-color:rgba(255,255,255,.6);background:rgba(255,255,255,.06)}
@media(prefers-reduced-motion:reduce){.footer__donate{transition:none}}
@media(max-width:930px){.site-header__inner .language-switch a{display:inline-flex;align-items:center;min-height:44px}.site-nav a{padding-block:8px}}

.brand{min-width:200px}.brand__name{font-size:22px;letter-spacing:.12em}.brand__name small{font-size:8px;letter-spacing:.14em;max-width:210px;line-height:1.5}.edition-line a:hover{color:var(--gold-bright)}
@media(max-width:1130px){.site-nav{gap:12px}.site-nav a{font-size:10px;letter-spacing:.07em}.brand{min-width:184px}}
@media(max-width:660px){.brand{min-width:0}.brand__name{font-size:20px}.brand__name small{font-size:7px;max-width:175px}.brand img{width:30px;height:30px}.site-header__inner{gap:10px}}
@media(max-width:420px){.footer__links{column-gap:1.5rem}.brand__name small{display:none}.site-header__inner{min-height:74px}}
</style>
